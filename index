     <script>
        document.addEventListener('DOMContentLoaded', function() {
            // ดึง Element ช่องค้นหา ปุ่ม และ การ์ดสินค้า
            const searchInput = document.querySelector('.search-input');
            const searchBtn = document.querySelector('.search-btn');
            const productCards = document.querySelectorAll('.product-card');

            // ฟังก์ชันสำหรับกรองสินค้า
            function filterProducts() {
                const searchTerm = searchInput.value.toLowerCase().trim();

                productCards.forEach(card => {
                    // ดึงข้อความจากชื่อสินค้า สเปก และราคา
                    const textContent = card.textContent.toLowerCase();

                    // ถ้ามีคำค้นหาให้แสดง ถ้าไม่มีให้ซ่อน
                    if (textContent.includes(searchTerm)) {
                        card.style.display = 'flex'; // แสดงสินค้า
                    } else {
                        card.style.display = 'none'; // ซ่อนสินค้า
                    }
                });
            }

            // ค้นหาอัตโนมัติขณะพิมพ์
            if (searchInput) {
                searchInput.addEventListener('keyup', filterProducts);
                searchInput.addEventListener('input', filterProducts);
            }

            // ค้นหาเมื่อคลิกปุ่ม
            if (searchBtn) {
                searchBtn.addEventListener('click', function(e) {
                    e.preventDefault();
                    filterProducts();
                });
            }
        });
    </script>

